@base = http://localhost:3823

# Real IDs from the restored local snapshot. Use returned IDs with another DB.
# POST /live/play writes telemetry; the examples below are reads only.

### OpenAPI
GET {{base}}/api-docs/v4/swagger.json

### Public activity for selected artists (repeat the query key)
GET {{base}}/api/v4/live/history?artist_ids=artist_3qmp7zjbg1rpebhtyfy43096vj&artist_ids=artist_6aaf982021nrst0m68ew1djerc&limit=20

### Browse: artists
GET {{base}}/api/v4/artists

### Browse: years
GET {{base}}/api/v4/artists/artist_3qmp7zjbg1rpebhtyfy43096vj/years

### Browse: year-by-number
GET {{base}}/api/v4/artists/artist_3qmp7zjbg1rpebhtyfy43096vj/years/by-number/1985

### Browse: artist-venues
GET {{base}}/api/v4/artists/artist_3qmp7zjbg1rpebhtyfy43096vj/venues

### Discovery: artist-anniversary
GET {{base}}/api/v4/artists/artist_3qmp7zjbg1rpebhtyfy43096vj/shows/on-date?month=7&day=7

### Discovery: exact-date-show
GET {{base}}/api/v4/artists/artist_3qmp7zjbg1rpebhtyfy43096vj/shows/by-date/1978-07-07

### Discovery: artist-recently-added

  "account_endpoints": [
    {
      "method": "GET",
      "path": "/v1/library/snapshot",
      "response_shape": "library_protocol_result",
      "sync_policy": "library_snapshot",
      "response_id_fields": {
        "favorites[].favorite_id": "favorite_",
        "favorites[].target.id": "catalog target prefix"
      }
    },
    {
      "method": "GET",
      "path": "/v1/library/changes",
      "response_shape": "library_protocol_result",
      "sync_policy": "library_changes",
      "response_id_fields": {
        "changes[].change_id": "library_change_",
        "changes[].favorite_id": "favorite_",
        "changes[].target.id": "catalog target prefix"
      }
    },
    {
      "method": "POST",
      "path": "/v1/library/favorite-mutations:batch",
      "response_shape": "library_protocol_result",
      "sync_policy": "command",
      "request_id_fields": {
        "mutations[].mutation_id": "mutation_",
        "mutations[].favorite_id": "favorite_ (required only for add)",
        "mutations[].target.id": "catalog target prefix"
      },
      "response_id_fields": {
        "results[].mutation_id": "mutation_",
        "results[].submitted_favorite_id": "favorite_ (optional)",
        "results[].canonical_favorite_id": "favorite_ (optional)",
        "conflicting_mutation_ids[]": "mutation_",
        "conflicting_favorite_ids[]": "favorite_"
      }
    },
    {
      "method": "GET",
      "path": "/v1/me",
      "response_shape": "resource",
      "sync_policy": "resource",
      "response_id_fields": {
        "user_id": "user_",
        "native_session_id": "session_ (optional)"
      }
    },
    {
      "method": "PATCH",
      "path": "/v1/me",
      "response_shape": "resource",
      "sync_policy": "command",
      "response_id_fields": {
        "user_id": "user_",
        "native_session_id": "session_ (optional)"
      },
      "request_id_fields": {
        "command_id": "command_"
      }
    }
  ],
  "sync_policies": {
    "command": "Apply the explicit command result only; no collection replacement inferred.",
    "resource": "Upsert the returned resource and supplied related fields; omission never removes unrelated entities or associations.",
    "artist_collection": "Replace this artist endpoint\u2019s association list for the exact request/filter; retain entity records, other query associations, favorites and offline data.",
    "full_show": "Upsert the show and nested sources/sets/tracks; replace active source associations for this show and set/track associations for each fully returned source/set. Retain entity records needed for offline playback and favorites.",
    "full_source": "Upsert source and nested sets/tracks; replace active sets for this source and tracks for each fully returned set. Related artist/show summaries are patches.",
    "detail_shows": "Upsert the resource and returned show summaries; replace only this resource\u2019s complete show association list, including an empty list. Save the payload ETag in the same local transaction. Retain shared show entities, downloads, favorites, and other query memberships. Artist-venue ID and artist-plus-venue alias identify the same membership owner.",
    "query_result": "Replace only the cached result of this exact URL and normalized query parameters; upsert returned entities. Never infer absence elsewhere from search/ranking/filtered/limited results.",
    "history": "With after_sequence append/deduplicate by event sequence; without it replace only the cached recent-history window for the exact request. Never delete catalog rows or personal playback history from omissions.",
    "resolver": "Apply per-reference availability and target results in input order; upsert deduplicated supplied entities and shallow parents only. Never replace unreturned child collections or remove catalog/favorite membership. POST is no-store without an ETag; no artist hydration unless explicitly requested.",
    "library_snapshot": "Apply authoritative membership for the authenticated account under the revised in-place library snapshot/cursor contract, not catalog replacement rules.",
    "library_changes": "Apply explicit ordered membership changes and advance the account cursor atomically; omissions do not remove membership.",
    "detail_tracks": "Upsert song metadata and returned track resources; replace only this song\u2019s complete file-match membership, including an empty list. Save the payload ETag in the same local transaction. This response has no shows property and does not change song-show membership or shared offline entities.",
    "artist_eras": "Replace only this artist\u2019s complete ordered era metadata, including an empty list. Eras have no public identity and are not shared entities. Save the ETag with the replacement.",
    "source_reviews": "Upsert returned review resources and replace this source\u2019s complete review membership, including an empty list. Save its ETag atomically. Other sources, catalog entities, and personal library membership remain unchanged.",
    "transient_ranking": "Use only as a transient online ranking view; do not apply its context-dependent popularity or entity membership to the persisted offline catalog. ETags support online revalidation. Open resources through their ordinary detail routes for catalog apply.",
    "live_summary": "Transient online activity for one completed window; use ordinary typed catalog resources for navigation. Replace only this exact summary view; omissions do not delete catalog records or account history. ETags support revalidation; shared caching lasts until the next minute, with up to one extra minute of stale serving."
  },
  "account_identity_storage": "Canonical full prefixed strings for application-owned IDs and catalog targets; OpenIddict/private surrogate keys remain internal UUIDs.",
  "account_routes": "Change existing /v1/library and /v1/me in place; no parallel library route version.",

{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "RelistenUserService": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://127.0.0.1:5443",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Accounts__EnableDevelopmentPersonas": "true",
        "Accounts__EnableExternalProviders": "false",
        "ACCOUNTS_DATABASE_URL": "Host=127.0.0.1;Port=15432;Database=relisten_db;Username=relisten;Password=local_dev_password",
        "ACCOUNTS_LOCK_DATABASE_URL": "Host=127.0.0.1;Port=15432;Database=relisten_db;Username=relisten;Password=local_dev_password"
      }
    },
    "RelistenUserService.LocalGoogle": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://127.0.0.1:5443",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Accounts__EnableDevelopmentPersonas": "false",
        "Accounts__EnableExternalProviders": "true",
        "Accounts__Google__Enabled": "true",
        "Accounts__Apple__Enabled": "false",
        "ACCOUNTS_DATABASE_URL": "Host=127.0.0.1;Port=15432;Database=relisten_db;Username=relisten;Password=local_dev_password",
        "ACCOUNTS_LOCK_DATABASE_URL": "Host=127.0.0.1;Port=15432;Database=relisten_db;Username=relisten;Password=local_dev_password"
      }
    }
  }
}
